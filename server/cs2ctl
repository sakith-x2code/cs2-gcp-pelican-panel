#!/usr/bin/env bash
# cs2ctl — manage the CS2 server on this machine.  Run `cs2ctl help`.
set -euo pipefail

BASE=/opt/cs2
APP="python3 $BASE/dashboard/app.py"
STATE="$BASE/state"
C=cs2
mkdir -p "$STATE"
# shellcheck disable=SC1091
[[ -f "$BASE/cs2.env" ]] && source "$BASE/cs2.env"
: "${AUTO_UPDATE:=1}" "${UPDATE_FORCE_AFTER_MIN:=90}" "${WATCHDOG:=1}"
: "${IDLE_SHUTDOWN:=1}" "${IDLE_SHUTDOWN_MIN:=60}"
[[ "$IDLE_SHUTDOWN_MIN" =~ ^[0-9]+$ && "$IDLE_SHUTDOWN_MIN" -ge 10 ]] || IDLE_SHUTDOWN_MIN=60
RUN=/run/cs2            # tmpfs: idle tracking resets on every boot
: "${NOTIFY_NTFY_SERVER:=https://ntfy.sh}" "${NOTIFY_NTFY_TOPIC:=}" "${NOTIFY_DISCORD_WEBHOOK:=}"

log() { echo "$(date '+%F %T') $*"; logger -t cs2ctl -- "$*" 2>/dev/null || true; }
need_root() { [[ $EUID -eq 0 ]] || { echo "Run with sudo"; exit 1; }; }
humans() { $APP humans 2>/dev/null || echo -1; }
cstate() { docker inspect -f '{{.State.Status}}' "$C" 2>/dev/null || echo missing; }
started_epoch() { date -d "$(docker inspect -f '{{.State.StartedAt}}' "$C" 2>/dev/null)" +%s 2>/dev/null || echo 0; }
updating() { docker top "$C" 2>/dev/null | grep -q steamcmd; }
rcon() { $APP rcon "$*"; }

usage() {
  cat <<'EOF'
cs2ctl — CS2 server control

  status              container + game status, players, build
  start | stop        start / stop the game container
  restart             restart the game (also installs any pending CS2 update)
  update              update CS2 now (warns players first if any are online)
  upgrade             pull newest server image + recreate container
  rcon "<cmd>"        run a console command
  say "<msg>"         broadcast in-game chat
  logs [N]            last N log lines (default 200);  logs -f to follow
  console             attach to the live server console (detach: Ctrl-P Ctrl-Q)
  config              show active settings (secrets hidden)
  autoupdate          (timer) apply CS2 updates when safe
  watchdog            (timer) restart a hung server
  idle [status|hold|resume]
                      idle auto-stop: show minutes left, pause until reboot, or re-enable
  idlecheck           (timer) power off the VM after IDLE_SHUTDOWN_MIN with no players
  notify test         send a test notification (ntfy app and/or Discord, see cs2.conf)
EOF
}

cmd_status() {
  cmd_idle status
  local s; s="$(cstate)"
  echo "Container: $s$(updating && echo ' (downloading/updating game files)')"
  [[ "$s" == running ]] || return 0
  $APP summary
}

cmd_update() {
  need_root
  local h; h="$(humans)"
  if [[ "$h" -gt 0 ]]; then
    rcon "say [SERVER] Restarting for a CS2 update in 60 seconds" >/dev/null 2>&1 || true
    sleep 30; rcon "say [SERVER] Update restart in 30 seconds — reconnect in ~2 minutes" >/dev/null 2>&1 || true
    sleep 30
  fi
  log "Restarting $C to apply CS2 update"
  rm -f "$STATE/update_pending"
  docker restart -t 30 "$C" >/dev/null
  echo "Restarted. The container updates CS2 before starting; watch: cs2ctl logs -f"
}

cmd_upgrade() {
  need_root
  cd "$BASE"
  log "Pulling newest images"
  docker compose pull -q
  docker compose up -d --remove-orphans
  docker image prune -f >/dev/null
  log "Upgrade complete"
}

cmd_autoupdate() {
  [[ "$AUTO_UPDATE" == "1" ]] || exit 0
  [[ "$(cstate)" == running ]] || exit 0
  updating && exit 0
  read -r inst latest < <($APP builds)
  if [[ "$inst" == 0 || "$latest" == 0 || "$latest" -le "$inst" ]]; then rm -f "$STATE/update_pending"; exit 0; fi
  local h; h="$(humans)"
  if [[ "$h" -le 0 ]]; then
    log "CS2 update $inst -> $latest, server empty: applying"
    rm -f "$STATE/update_pending"; docker restart -t 30 "$C" >/dev/null; exit 0
  fi
  [[ -f "$STATE/update_pending" ]] || date +%s >"$STATE/update_pending"
  local since=$(( ( $(date +%s) - $(cat "$STATE/update_pending") ) / 60 ))
  if [[ "$since" -ge "$UPDATE_FORCE_AFTER_MIN" ]]; then
    log "CS2 update pending ${since} min with $h players: forcing"
    cmd_update
  else
    rcon "say [SERVER] A CS2 update is available. The server will update when empty." >/dev/null 2>&1 || true
    log "CS2 update $inst -> $latest waiting for $h players to leave (${since}/${UPDATE_FORCE_AFTER_MIN} min)"
  fi
}

cmd_watchdog() {
  track_game_state
  [[ "$WATCHDOG" == "1" ]] || exit 0
  [[ "$(cstate)" == running ]] || { rm -f "$STATE/watchdog_fails"; exit 0; }
  updating && exit 0
  (( $(date +%s) - $(started_epoch) > 900 )) || exit 0       # allow 15 min to boot
  if [[ "$(humans)" -ge 0 ]]; then rm -f "$STATE/watchdog_fails"; exit 0; fi
  local n=$(( $(cat "$STATE/watchdog_fails" 2>/dev/null || echo 0) + 1 ))
  echo "$n" >"$STATE/watchdog_fails"
  log "Watchdog: game not answering RCON ($n/3)"
  if [[ "$n" -ge 3 ]]; then
    log "Watchdog: restarting hung server"
    notify "CS2 server restarting" "The game was unresponsive for ~6 min, so the watchdog is restarting it." "warning"
    rm -f "$STATE/watchdog_fails"
    docker restart -t 20 "$C" >/dev/null
  fi
}

# ---------------------------------------------------------------- notifications
# Push to the ntfy phone app (NOTIFY_NTFY_TOPIC) and/or a Discord channel (NOTIFY_DISCORD_WEBHOOK).
# Never fails the caller: a notification problem must not stop a shutdown or a restart.
addr() { echo "${EXTERNAL_IP:-?}:27015"; }
dash_url() { echo "https://${DASH_DOMAIN:-${EXTERNAL_IP//./-}.sslip.io}"; }

notify() {   # notify <title> <message> [ntfy-tags] [priority 1-5]
  local title="$1" msg="$2" tags="${3:-}" prio="${4:-3}" sent=0
  if [[ -n "$NOTIFY_NTFY_TOPIC" ]]; then
    if curl -fsS -m 10 -o /dev/null \
      -H "Title: $title" -H "Tags: $tags" -H "Priority: $prio" -H "Click: $(dash_url)" \
      --data-binary "$msg" "${NOTIFY_NTFY_SERVER%/}/${NOTIFY_NTFY_TOPIC}" 2>/dev/null; then sent=1; else log "notify: ntfy send failed"; fi
  fi
  if [[ -n "$NOTIFY_DISCORD_WEBHOOK" ]]; then
    local body
    body="$(python3 -c 'import json,sys; print(json.dumps({"username":"CS2 server","content":"**"+sys.argv[1]+"**\n"+sys.argv[2]}))' "$title" "$msg")"
    if curl -fsS -m 10 -o /dev/null -H 'Content-Type: application/json' -d "$body" "$NOTIFY_DISCORD_WEBHOOK" 2>/dev/null; then
      sent=1; else log "notify: Discord send failed"; fi
  fi
  if [[ "$sent" == 1 ]]; then log "notify: $title"; fi
  return 0
}

# Called every 2 min (watchdog timer): tell people when the game comes online or goes down.
track_game_state() {
  mkdir -p "$RUN"
  local prev now h; prev="$(cat "$RUN/game_state" 2>/dev/null || echo boot)"
  if [[ "$(cstate)" == running ]] && updating; then now=updating
  else h="$(humans)"; if [[ "$h" -ge 0 ]]; then now=online; else now=offline; fi; fi
  [[ "$now" == "$prev" ]] && return 0
  echo "$now" >"$RUN/game_state"
  case "$now" in
    online)   notify "CS2 server is online" "Join: connect $(addr)${CS2_PW:+ (password required)}" "green_circle,video_game" 4 ;;
    updating) if [[ "$prev" == online ]]; then notify "CS2 server is updating" "Downloading a CS2 update. Back online in a few minutes." "arrows_counterclockwise"; fi ;;
    offline)  if [[ "$prev" == online ]]; then notify "CS2 server is down" "The game stopped answering. The watchdog restarts it after ~6 min if it doesn't recover." "red_circle,warning" 4; fi ;;
  esac
  return 0
}

cmd_notify() {
  case "${1:-test}" in
    test)
      [[ -n "$NOTIFY_NTFY_TOPIC$NOTIFY_DISCORD_WEBHOOK" ]] || { echo "No notifications configured: set NOTIFY_NTFY_TOPIC and/or NOTIFY_DISCORD_WEBHOOK in cs2.conf, then sudo ./vm-install.sh"; exit 1; }
      notify "CS2 test notification" "Notifications from $(hostname) work. Server: $(addr)" "white_check_mark"
      echo "Sent. Check your phone${NOTIFY_DISCORD_WEBHOOK:+ / Discord}." ;;
    boot)     # cs2-notify.service start
      mkdir -p "$RUN"; echo boot >"$RUN/game_state"
      notify "CS2 VM started" "The game server is starting; you'll get another message when it's joinable (1-2 min, longer if updating)." "rocket" ;;
    shutdown) # cs2-notify.service stop (VM powering off or rebooting)
      local reason; reason="$(cat "$RUN/stop_reason" 2>/dev/null || true)"
      if systemctl list-jobs 2>/dev/null | grep -q 'reboot.target'; then
        notify "CS2 VM rebooting" "${reason:-The VM is rebooting.} Back in a few minutes." "arrows_counterclockwise"
      else
        notify "CS2 VM stopped" "${reason:-The VM is shutting down.} Start it again with ./cs2-gcp.sh start or the Cloud Console." "black_circle,zzz"
      fi ;;
    *) echo "Usage: cs2ctl notify test"; exit 1 ;;
  esac
}

# ---------------------------------------------------------------- idle auto-stop
# Every 5 min: if no human players (and nobody logged in over SSH) for IDLE_SHUTDOWN_MIN,
# power off. On GCP a guest power-off STOPS the VM (status TERMINATED): disk, game files
# and static IP are kept, compute billing stops. Start it again with ./cs2-gcp.sh start.
idle_reset() { rm -f "$RUN/idle_since" "$RUN/idle_warned"; }

cmd_idlecheck() {
  mkdir -p "$RUN"
  if [[ "$IDLE_SHUTDOWN" != "1" || -f "$RUN/idle_hold" ]]; then idle_reset; exit 0; fi
  if updating; then idle_reset; exit 0; fi                     # never stop mid-download/update
  local sessions; sessions="$( (who 2>/dev/null || true) | wc -l)"
  if [[ "$sessions" -gt 0 ]]; then idle_reset; exit 0; fi      # an admin is logged in
  local h; h="$(humans)"
  if [[ "$h" -gt 0 ]]; then idle_reset; exit 0; fi
  # 0 humans, or the game isn't answering (nobody can be playing)
  local now since; now="$(date +%s)"
  [[ -f "$RUN/idle_since" ]] || { echo "$now" >"$RUN/idle_since"; log "Idle: no players, auto-stop in ${IDLE_SHUTDOWN_MIN} min"; }
  since="$(cat "$RUN/idle_since")"
  local idle_min=$(( (now - since) / 60 ))
  if [[ "$idle_min" -ge "$IDLE_SHUTDOWN_MIN" ]]; then
    log "Idle: no players for ${idle_min} min — powering off the VM"
    echo "No players for ${idle_min} min (idle auto-stop)." >"$RUN/stop_reason"
    idle_reset
    systemctl poweroff
  elif [[ "$idle_min" -ge $(( IDLE_SHUTDOWN_MIN - 10 )) && ! -f "$RUN/idle_warned" ]]; then
    touch "$RUN/idle_warned"
    notify "CS2 VM stops in ~10 min" "No players for ${idle_min} min. Join now (connect $(addr)) to keep it running." "hourglass"
  fi
}

cmd_idle() {
  mkdir -p "$RUN"
  case "${1:-status}" in
    hold)   need_root; touch "$RUN/idle_hold"; idle_reset; echo "Idle auto-stop paused until the next reboot (resume: cs2ctl idle resume)";;
    resume) need_root; rm -f "$RUN/idle_hold"; echo "Idle auto-stop active";;
    status)
      if [[ "$IDLE_SHUTDOWN" != "1" ]]; then echo "Idle auto-stop: disabled (IDLE_SHUTDOWN=0)"
      elif [[ -f "$RUN/idle_hold" ]]; then echo "Idle auto-stop: paused until reboot"
      elif [[ -f "$RUN/idle_since" ]]; then
        local m=$(( ($(date +%s) - $(cat "$RUN/idle_since")) / 60 ))
        echo "Idle auto-stop: no players for ${m} min — VM powers off in ~$(( IDLE_SHUTDOWN_MIN - m > 0 ? IDLE_SHUTDOWN_MIN - m : 0 )) min"
      else echo "Idle auto-stop: armed (${IDLE_SHUTDOWN_MIN} min with no players)"; fi;;
    *) echo "Usage: cs2ctl idle [status|hold|resume]"; exit 1;;
  esac
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  status)     cmd_status ;;
  start)      need_root; docker start "$C" >/dev/null && echo started ;;
  stop)       need_root; docker stop -t 30 "$C" >/dev/null && echo stopped ;;
  restart)    need_root; docker restart -t 30 "$C" >/dev/null && echo restarted ;;
  update)     cmd_update ;;
  upgrade)    cmd_upgrade ;;
  rcon)       rcon "$*" ;;
  say)        rcon "say $*" ;;
  logs)       if [[ "${1:-}" == "-f" ]]; then docker logs -f --tail 100 "$C"; else docker logs --tail "${1:-200}" "$C" 2>&1; fi ;;
  console)    echo "Attaching — detach with Ctrl-P then Ctrl-Q (Ctrl-C stops the server!)"; docker attach "$C" ;;
  config)     grep -vE 'PW|PASSWORD|TOKEN' "$BASE/cs2.env" ;;
  autoupdate) cmd_autoupdate ;;
  watchdog)   cmd_watchdog ;;
  idlecheck)  cmd_idlecheck ;;
  idle)       cmd_idle "${1:-status}" ;;
  notify)     need_root; cmd_notify "${1:-test}" ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
